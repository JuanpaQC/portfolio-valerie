---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { perfil } from '../../data/perfil';
import { routes, useTranslations, type Lang } from '../../i18n/ui';
import portada from '../../assets/vale-profile.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const description =
  lang === 'es'
    ? `${perfil.nombre}, actriz. Teatro, cine y televisión.`
    : `${perfil.nombre}, actress. Theatre, film and television.`;
---

<BaseLayout
  lang={lang}
  title={perfil.profesion[lang]}
  description={description}
  translatedPath={routes.inicio[lang === 'es' ? 'en' : 'es']}
  ogImage={portada.src}
>
  <section class="portada">
    <div class="portada-imagen">
      <Image
        src={portada}
        alt={
          lang === 'es'
            ? `${perfil.nombre} sonríe a cámara con un top color teja, ante un jardín tropical`
            : `${perfil.nombre} smiling at the camera in a terracotta top, in front of a tropical garden`
        }
        widths={[480, 800, 1200]}
        sizes="(min-width: 48rem) 60vw, 100vw"
        loading="eager"
      />
    </div>
    <div class="portada-texto">
      <h1>{perfil.nombre}</h1>
      <p class="portada-profesion">{perfil.profesion[lang]}</p>
      <p class="portada-frase">{perfil.frase[lang]}</p>
      <p style="margin-top: 2.5rem;">
        <a class="boton" href={routes.trabajo[lang]}>{t('nav.trabajo')}</a>
      </p>
    </div>
  </section>
</BaseLayout>

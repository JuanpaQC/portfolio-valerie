---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { perfil } from '../../data/perfil';
import { routes, useTranslations, type Lang } from '../../i18n/ui';
import retrato from '../../assets/vale-profile.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  title={t('sobreMi.titulo')}
  description={perfil.bio[lang]}
  translatedPath={routes.sobreMi[lang === 'es' ? 'en' : 'es']}
  ogImage={retrato.src}
>
  <h1>{t('sobreMi.titulo')}</h1>
  <div class="sobre-mi">
    <Image
      class="revelar"
      src={retrato}
      alt={
        lang === 'es'
          ? `${perfil.nombre} sonríe a cámara con un top color teja, ante un jardín tropical`
          : `${perfil.nombre} smiling at the camera in a terracotta top, in front of a tropical garden`
      }
      widths={[450, 900]}
      sizes="(min-width: 48rem) 40vw, 100vw"
    />
    <div class="revelar" style="--revelar-orden: 1">
      {perfil.statement[lang].map((parrafo) => <p>{parrafo}</p>)}
      <h2 style="margin-top: 2.5rem;">Bio</h2>
      <p class="intro-pagina">{perfil.bio[lang]}</p>
    </div>
  </div>
</BaseLayout>

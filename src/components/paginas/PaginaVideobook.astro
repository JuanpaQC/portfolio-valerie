---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { perfil } from '../../data/perfil';
import { routes, useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const embedUrl = import.meta.env.PUBLIC_VIDEOBOOK_EMBED_URL as string | undefined;
const description =
  lang === 'es'
    ? `Videobook de ${perfil.nombre}, actriz.`
    : `${perfil.nombre}'s showreel.`;
---

<BaseLayout
  lang={lang}
  title={t('videobook.titulo')}
  description={description}
  translatedPath={routes.videobook[lang === 'es' ? 'en' : 'es']}
>
  <h1>{t('videobook.titulo')}</h1>
  {
    embedUrl ? (
      <div class="marco-video">
        <iframe
          src={embedUrl}
          title={t('videobook.titulo')}
          loading="lazy"
          allow="fullscreen; picture-in-picture"
          allowfullscreen
        />
      </div>
    ) : (
      <p class="intro-pagina">{t('videobook.pendiente')}</p>
    )
  }
</BaseLayout>

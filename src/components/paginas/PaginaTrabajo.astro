---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { trabajosPorCategoria } from '../../lib/trabajos';
import { traducido } from '../../i18n/contenido';
import { routes, trabajoUrl, useTranslations, type Lang, type UiKey } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const grupos = await trabajosPorCategoria();
const description =
  lang === 'es'
    ? 'Trabajos en teatro, cine, televisión y cortometraje.'
    : 'Work in theatre, film, television and short film.';
---

<BaseLayout
  lang={lang}
  title={t('trabajo.titulo')}
  description={description}
  translatedPath={routes.trabajo[lang === 'es' ? 'en' : 'es']}
>
  <h1>{t('trabajo.titulo')}</h1>

  {
    [...grupos.entries()].map(([categoria, trabajos]) => (
      <section class="grupo-categoria" aria-labelledby={`cat-${categoria}`}>
        <h2 id={`cat-${categoria}`}>{t(`categoria.${categoria}` as UiKey)}</h2>
        <ul class="rejilla-trabajos" style="list-style: none; padding: 0; margin: 0;">
          {trabajos.map((trabajo, indice) => (
            <li class="tarjeta-trabajo revelar" style={`--revelar-orden: ${indice}`}>
              <a href={trabajoUrl(lang, trabajo.id.replace(/\.md$/, ''))}>
                <div class="tarjeta-media">
                  <Image
                    src={trabajo.data.imagen}
                    alt={traducido(trabajo.data, 'alt', lang)}
                    widths={[400, 700, 1000]}
                    sizes="(min-width: 56rem) 33vw, (min-width: 34rem) 50vw, 100vw"
                    style={`view-transition-name: trabajo-${trabajo.id}`}
                  />
                </div>
                <h3>{traducido(trabajo.data, 'titulo', lang)}</h3>
                <p>
                  {traducido(trabajo.data, 'rol', lang)} · {trabajo.data.anio}
                </p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</BaseLayout>

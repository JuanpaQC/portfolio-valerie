---
import '../styles/global.css';
import { perfil } from '../data/perfil';
import { routes, secciones, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Ruta equivalente en el otro idioma, para el selector y hreflang. */
  translatedPath: string;
  /** Imagen Open Graph (ruta absoluta generada por Astro). Opcional. */
  ogImage?: string;
}

const { lang, title, description, translatedPath, ogImage } = Astro.props;
const t = useTranslations(lang);
const otherLang: Lang = lang === 'es' ? 'en' : 'es';

const currentPath = Astro.url.pathname;
const canonical = new URL(currentPath, Astro.site);
const alternate = new URL(translatedPath, Astro.site);

// El sitio es una sola página: la navegación son anclas a las secciones.
const nav = secciones.map((seccion) => ({
  href: `#${seccion.id}`,
  label: t(seccion.clave),
}));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {perfil.nombre}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={otherLang} href={alternate} />
    <meta property="og:title" content={`${title} · ${perfil.nombre}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site)} />}
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <header class="cabecera contenedor">
      <div class="cabecera-fila">
        <a class="marca" href={routes.inicio[lang]}>{perfil.nombre}</a>

        <nav class="nav nav-escritorio" aria-label={t('nav.inicio')}>
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
          <span class="selector-idioma" aria-label="Idioma / Language">
            <a href={lang === 'es' ? currentPath : translatedPath} aria-current={lang === 'es' ? 'true' : undefined}>ES</a>
            {' / '}
            <a href={lang === 'en' ? currentPath : translatedPath} aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
          </span>
        </nav>

        <button
          class="nav-hamburguesa"
          popovertarget="menu-movil"
          aria-label={t('nav.abrirMenu')}
        >
          <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 7h18M3 15h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none"></path>
          </svg>
        </button>
      </div>
    </header>

    <div id="menu-movil" popover class="menu-movil">
      <div class="menu-movil-cabecera contenedor">
        <span class="marca">{perfil.nombre}</span>
        <button
          class="nav-hamburguesa"
          popovertarget="menu-movil"
          popovertargetaction="hide"
          aria-label={t('nav.cerrarMenu')}
        >
          <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none"></path>
          </svg>
        </button>
      </div>
      <nav class="menu-movil-enlaces contenedor" aria-label={t('nav.inicio')}>
        {
          nav.map((item, indice) => (
            <a href={item.href} style={`--revelar-orden: ${indice}`}>
              {item.label}
            </a>
          ))
        }
      </nav>
      <div class="menu-movil-idioma contenedor" style={`--revelar-orden: ${nav.length}`}>
        <a href={lang === 'es' ? currentPath : translatedPath} aria-current={lang === 'es' ? 'true' : undefined}>Español</a>
        <a href={lang === 'en' ? currentPath : translatedPath} aria-current={lang === 'en' ? 'true' : undefined}>English</a>
      </div>
    </div>

    <main class="contenedor">
      <slot />
    </main>

    <footer class="pie">
      <div class="contenedor">
        <p style="margin: 0;">
          © {new Date().getFullYear()} {perfil.nombre}. {t('footer.derechos')}
        </p>
        <p style="margin: 0.35rem 0 0;">
          {t('footer.desarrollo')}
          {
            perfil.desarrollador.url ? (
              <a href={perfil.desarrollador.url} target="_blank" rel="noopener">
                {perfil.desarrollador.nombre}
              </a>
            ) : (
              perfil.desarrollador.nombre
            )
          }.
        </p>
      </div>
    </footer>

    <script>
      // Al elegir una sección en el menú móvil (anclas en la misma página),
      // el popover no se cierra solo: lo cerramos al hacer clic en un enlace.
      const menu = document.getElementById('menu-movil');
      menu?.addEventListener('click', (evento) => {
        if ((evento.target as Element).closest('a')) {
          (menu as HTMLElement & { hidePopover(): void }).hidePopover();
        }
      });
    </script>
  </body>
</html>

---
import { getCollection } from 'astro:content';
import PaginaTrabajoDetalle from '../../components/paginas/PaginaTrabajoDetalle.astro';

export async function getStaticPaths() {
  const trabajos = await getCollection('trabajos');
  return trabajos.map((trabajo) => ({
    params: { slug: trabajo.id },
    props: { trabajo },
  }));
}

const { trabajo } = Astro.props;
---

<PaginaTrabajoDetalle lang="es" trabajo={trabajo} />

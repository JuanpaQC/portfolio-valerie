# Copiar a .env y rellenar.
# Las variables PUBLIC_ se exponen al navegador (Astro).

# Endpoint del formulario de contacto (Formspree: https://formspree.io)
# Si está vacío, la página de contacto muestra solo el correo, sin formulario.
PUBLIC_FORMSPREE_ENDPOINT=

# URL del videobook/showreel (YouTube o Vimeo, URL de embed)
# p.ej. https://player.vimeo.com/video/123456789
PUBLIC_VIDEOBOOK_EMBED_URL=
